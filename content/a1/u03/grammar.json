  {
    "id": "g-a1-0012",
    "title": "I numeri da 21 a 100",
    "explanationIt": [
      "Dopo il 20 il tedesco dice prima le unità e poi le decine, unite da und, tutto attaccato: 21 = einundzwanzig, cioè «uno-e-venti».",
      "Le decine finiscono in -zig, tranne il 30 che finisce in -ßig: dreißig. Come sechzehn e siebzehn, anche sechzig e siebzig si accorciano.",
      "Davanti a und, eins perde la s: einundzwanzig. Il 100 è hundert, o einhundert."
    ],
    "pattern": [
      "21 – einundzwanzig",
      "22 – zweiundzwanzig",
      "30 – dreißig",
      "35 – fünfunddreißig",
      "47 – siebenundvierzig",
      "60 – sechzig",
      "70 – siebzig",
      "99 – neunundneunzig",
      "100 – hundert"
    ],
    "examples": [
      {
        "de": "Meine Mutter ist fünfzig.",
        "it": "Mia madre ha cinquant'anni."
      },
      {
        "de": "Mein Opa ist neunundachtzig Jahre alt.",
        "it": "Mio nonno ha ottantanove anni."
      },
      {
        "de": "Ich bin einunddreißig.",
        "it": "Ho trentun anni."
      }
    ],
    "commonMistakes": [
      {
        "wrong": "zwanzigeins",
        "right": "einundzwanzig",
        "explanationIt": "Prima le unità, poi le decine, unite da und."
      },
      {
        "wrong": "einsundzwanzig",
        "right": "einundzwanzig",
        "explanationIt": "Davanti a und, eins perde la s."
      },
