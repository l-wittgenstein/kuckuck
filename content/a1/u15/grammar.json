  {
    "id": "g-a1-0059",
    "title": "Il participio dei verbi regolari",
    "explanationIt": [
      "Di solito: ge- + radice + -t. machen → gemacht, hören → gehört, wohnen → gewohnt.",
      "Se la radice finisce in -t o -d si aggiunge -et: arbeiten → gearbeitet, warten → gewartet.",
      "I verbi in -ieren non prendono ge-: studieren → studiert, telefonieren → telefoniert, fotografieren → fotografiert.",
      "Nemmeno i verbi che cominciano con be-, ver-, er- (e pochi altri prefissi): besuchen → besucht, bezahlen → bezahlt, verdienen → verdient, erzählen → erzählt. I verbi separabili, come einkaufen → eingekauft, li vedrai nella prossima unità."
    ],
    "pattern": [
      "machen → gemacht – fatto",
      "arbeiten → gearbeitet – lavorato",
      "warten → gewartet – aspettato",
      "studieren → studiert – studiato",
      "telefonieren → telefoniert – telefonato",
      "besuchen → besucht – visitato",
      "erzählen → erzählt – raccontato"
    ],
    "examples": [
      { "de": "Ich habe gestern lange gearbeitet.", "it": "Ieri ho lavorato a lungo." },
      { "de": "Sie hat in Bologna studiert.", "it": "Ha studiato a Bologna." },
      { "de": "Wir haben unsere Freunde besucht.", "it": "Siamo andati a trovare i nostri amici." }
    ],
    "commonMistakes": [
      {
        "wrong": "Ich habe gestudiert.",
        "right": "Ich habe studiert.",
        "explanationIt": "I verbi in -ieren non prendono ge-."
      },
      {
        "wrong": "Wir haben Oma gebesucht.",
        "right": "Wir haben Oma besucht.",
        "explanationIt": "I verbi con be- non prendono ge-."
      },
      {
        "wrong": "Er hat viel gearbeit.",
        "right": "Er hat viel gearbeitet.",
        "explanationIt": "Dopo -t si aggiunge -et: gearbeitet."
      }
    ],
    "exercises": [
