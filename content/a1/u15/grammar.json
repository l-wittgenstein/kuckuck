        "right": "Ich habe gekocht.",
        "explanationIt": "kochen vuole haben."
      },
      {
        "wrong": "Gestern ich habe gearbeitet.",
        "right": "Gestern habe ich gearbeitet.",
        "explanationIt": "haben resta al secondo posto, subito dopo gestern."
      }
