  {
    "id": "g-a1-0008",
    "title": "Il verbo haben (avere)",
    "explanationIt": [
      "«haben» è quasi regolare: solo con du e con er/sie/es la b sparisce. Du hast, er hat.",
      "Attenzione all'età: in tedesco non si «ha» un'età, si «è». Ich bin drei = ho tre anni.",
      "Quando un sostantivo maschile è l'oggetto della frase (per esempio dopo haben), ein diventa einen: Ich habe einen Bruder. È il caso accusativo, che vedremo meglio più avanti. Con il femminile e il neutro non cambia niente: eine Schwester, ein Kind."
    ],
    "pattern": [
      "ich habe – io ho",
      "du hast – tu hai",
      "er/sie/es hat – lui/lei ha",
      "wir haben – noi abbiamo",
      "ihr habt – voi avete",
      "sie haben – loro hanno",
      "Sie haben – Lei ha"
    ],
    "examples": [
      { "de": "Ich habe eine Schwester.", "it": "Ho una sorella." },
      { "de": "Hast du einen Hund?", "it": "Hai un cane?" },
      { "de": "Anna hat zwei Kinder.", "it": "Anna ha due figli." },
      { "de": "Wir haben ein Auto.", "it": "Abbiamo una macchina." }
    ],
    "commonMistakes": [
      {
        "wrong": "du habst",
        "right": "du hast",
        "explanationIt": "Con du la b sparisce: hast."
      },
      {
        "wrong": "er habt",
        "right": "er hat",
        "explanationIt": "Con er, sie, es: hat."
      },
      {
        "wrong": "Ich habe drei Jahre.",
        "right": "Ich bin drei (Jahre alt).",
        "explanationIt": "Per l'età si usa sein, non haben."
      },
      {
        "wrong": "Ich habe ein Bruder.",
        "right": "Ich habe einen Bruder.",
        "explanationIt": "Bruder è maschile ed è l'oggetto della frase, quindi ein diventa einen."
      }
    ],
    "exercises": [
