  {
    "id": "g-a1-0014",
    "title": "Verbi che cambiano vocale: essen e nehmen",
    "explanationIt": [
      "Alcuni verbi cambiano la vocale della radice, ma solo con du e con er/sie/es. Le altre persone sono regolari.",
      "essen: la e diventa i, du isst, er isst. La radice finisce già in s, quindi con du si aggiunge solo -t: du isst, come du heißt.",
      "nehmen: la e diventa i, la h cade e la m raddoppia: du nimmst, er nimmt."
    ],
    "pattern": [
      "ich esse – io mangio",
      "du isst – tu mangi",
      "er/sie/es isst – lui/lei mangia",
      "wir essen – noi mangiamo",
      "ihr esst – voi mangiate",
      "sie/Sie essen – loro mangiano / Lei mangia",
      "du nimmst – tu prendi",
      "er/sie/es nimmt – lui/lei prende"
    ],
    "examples": [
      {
        "de": "Was isst du?",
        "it": "Cosa mangi?"
      },
      {
        "de": "Anna isst kein Fleisch.",
        "it": "Anna non mangia carne."
      },
      {
        "de": "Was nimmst du?",
        "it": "Cosa prendi?"
      },
      {
        "de": "Er nimmt den Fisch.",
        "it": "Prende il pesce."
      }
    ],
    "commonMistakes": [
      {
        "wrong": "du esst",
        "right": "du isst",
        "explanationIt": "Con du la e diventa i."
      },
      {
        "wrong": "er nehmt",
        "right": "er nimmt",
        "explanationIt": "Con er: nimmt, con la doppia m."
      },
      {
        "wrong": "ich isse",
        "right": "ich esse",
        "explanationIt": "Con ich la vocale non cambia."
      }
    ],
    "exercises": [
